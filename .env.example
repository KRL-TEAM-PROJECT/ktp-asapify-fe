# mock = data fiktif backtest Kalteng 24 Sep 2023 (tanpa backend)
# live = panggil asapify-api di {VITE_API_BASE}/api/v1
VITE_API_MODE=mock
VITE_API_BASE=
# GeoJSON batas gambut dan batas provinsi di bucket publik (mode live)
VITE_PEAT_LAYER_URL=
VITE_PROVINCES_LAYER_URL=

# Firebase web app config (public identifiers; never put Admin/SA keys in VITE_*).
