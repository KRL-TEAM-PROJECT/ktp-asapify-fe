# mock = fictional Central Kalimantan backtest data, 24 Sep 2023 (no backend)
# live = call asapify-api at {VITE_API_BASE}/api/v1
VITE_API_MODE=mock
VITE_API_BASE=
# Peat and province boundary GeoJSON in the public bucket (live mode)
VITE_PEAT_LAYER_URL=
VITE_PROVINCES_LAYER_URL=

# Firebase web app config (public identifiers; never put Admin/SA keys in VITE_*).
# Required only when VITE_API_MODE=live.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hack2skill-510921
VITE_FIREBASE_APP_ID=

# Push for non-emergency messages/exercises only. Public Firebase web configuration.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
